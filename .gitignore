# secrets and environments
.env
.env.*
.venv/
__pycache__/
*.pyc

# data: vendor files are licensed for personal use (EODHD) or are large public archives (Binance, SEC);
# nothing under data/ is published. Acquisition scripts and hashes in the repository reproduce it.
data/

# large or binary experiment artefacts (every report folder keeps its JSON/MD/small CSV results)
reports/**/*.parquet
reports/**/*.npz
reports/**/*.zip
reports/*.zip
reports/**/daily_panel.csv
reports/**/*_features.csv

# human labelling work in progress and its backups (labels are published deliberately, not by accident).
# The final frozen reference files ARE published; only in-progress copies and periodic snapshots are excluded.
research/phase8b/*_LABELED.csv
research/phase8b/**/*_LABELED.csv
research/phase8b/backups/
research/phase8b/**/backups/
research/phase8b/PHASE8B_HUMAN_LABELING_INTEGRITY.txt
research/phase8b/**/PHASE8B_GOLD*_LABELING_INTEGRITY.txt

# local tooling
.claude/
*.log
*.tmp

# bar-by-bar equity paths of the crypto phases (2.4 GB); summary results of the same runs are published
reports/**/*_path.csv

# vendor symbol list and a duplicate copy of the labelling package kept at the root
/supported_tickers.zip
/phase8b_labeling_package.zip

# Phase 11A (prospective rule; earlier phases' committed PDFs are not rewritten): third-party academic papers and
# their full-text conversions stay local and untracked. Bibliographic details, URLs and the decision-relevant facts
# are kept in SOURCES.txt.
reports/phase11a/raw/literature/*
!reports/phase11a/raw/literature/SOURCES.txt

# Phase 11B (same prospective rule as Phase 11A): third-party papers and full-text conversions stay local; the tracked
# record is SOURCES.txt.
reports/phase11b/raw/literature/*
!reports/phase11b/raw/literature/SOURCES.txt
# Phase 11B raw web captures (third-party pages, vendor catalogs, contract source mirrors) stay local; their URL
# indexes and RAW_MANIFEST_SHA256.txt are tracked. The quarantine folder holds product pages that may embed prices.
reports/phase11b/raw/sources/*_snapshots/*
!reports/phase11b/raw/sources/*_snapshots/INDEX.md
!reports/phase11b/raw/sources/*_snapshots/_index.md
